  "api_base_url": "http://localhost:8000/api",
  "authentication": {
    "methods": ["session", "jwt"],
    "cors_credentials": true,
    "auto_login_after_register": true,
    "endpoints": {
      "register": {
        "url": "POST /api/user/register/",
        "description": "Registro de usuario con login automático",
        "request_body": {
          "username": "string (único)",
          "email": "string (único)",
          "password": "string",
          "password2": "string",
          "first_name": "string (opcional)",
          "last_name": "string (opcional)",
          "phone": "string (opcional)",
          "address": "string (opcional)"
        },
        "response_success": {
          "status": 201,
          "body": {
            "message": "Usuario registrado e iniciado sesión exitosamente",
            "user": {
              "id": "number",
              "username": "string",
              "email": "string",
              "first_name": "string",
              "last_name": "string",
              "phone": "string|null",
              "address": "string|null",
              "roles": "string (siempre 'cliente')",
              "role": "string (siempre 'cliente')",
              "date_joined": "datetime"
            },
            "session_id": "string"
          }
        },
        "response_error": {
          "status": 400,
          "body": {
            "username": ["Ya existe un usuario con ese nombre. Elige otro."],
            "email": ["Ya existe un usuario registrado con ese email."],
            "password": ["Las contraseñas no coinciden."]
          }
        }
      },
      "login": {
        "url": "POST /api/user/login/",
        "description": "Inicio de sesión con username o email",
        "request_body": {
          "identifier": "string (username o email)",
          "password": "string"
        },
        "response_success": {
          "status": 200,
          "body": {
            "message": "Login exitoso",
            "user": {
              "id": "number",
              "username": "string",
              "email": "string",
              "first_name": "string",
              "last_name": "string",
              "phone": "string|null",
              "address": "string|null",
              "roles": "string",
              "role": "string",
              "date_joined": "datetime"
            },
            "session_id": "string"
          }
        }
      },
      "logout": {
        "url": "POST /api/user/logout/",
        "description": "Cerrar sesión",
        "response_success": {
          "status": 200,
          "body": {
            "message": "Logout exitoso",
            "session_cleared": true
          }
        }
      },
      "profile": {
        "url": "GET /api/user/profile/",
        "description": "Obtener perfil del usuario autenticado",
        "response_success": {
          "status": 200,
          "body": {
            "id": "number",
            "username": "string",
            "email": "string",
            "first_name": "string",
            "last_name": "string",
            "phone": "string|null",
            "address": "string|null",
            "roles": "string",
            "role": "string",
            "date_joined": "datetime"
          }
        }
      },
      "session_status": {
        "url": "GET /api/user/session-status/",
        "description": "Verificar estado de sesión",
        "response_authenticated": {
          "status": 200,
          "body": {
            "authenticated": true,
            "user": "object (user data)",
            "session_id": "string"
          }
        },
        "response_not_authenticated": {
          "status": 200,
          "body": {
            "authenticated": false,
            "message": "Usuario no autenticado"
          }
        }
      }
    }
  },
  "branding_services": {
