      "orders": {
        "list": {
          "url": "GET /api/branding/orders/",
          "description": "Lista pedidos del usuario",
          "permission": "authenticated"
        },
        "create": {
          "url": "POST /api/branding/orders/",
          "description": "Crear pedido desde carrito",
          "permission": "authenticated"
        }
      },
      "cart": {
        "list": {
          "url": "GET /api/branding/shopping-cart/",
          "description": "Obtener carrito del usuario",
          "permission": "authenticated"
        },
        "add_item": {
          "url": "POST /api/branding/shopping-cart-details/",
          "description": "Agregar producto al carrito",
          "permission": "authenticated"
        }
      }
    }
  },
