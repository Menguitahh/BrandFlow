  "quotes_and_projects": {
    "endpoints": {
      "quotes": {
        "list": {
          "url": "GET /api/branding/quotes/",
          "description": "Lista cotizaciones (filtradas por usuario)",
          "filters": "client === user_id"
        },
        "create": {
          "url": "POST /api/branding/quotes/",
          "description": "Crear cotización",
          "request_body": {
            "title": "string",
            "description": "string",
            "budget": "decimal (opcional)",
            "service": "number (service_id)"
          }
        },
        "approve": {
          "url": "POST /api/branding/quotes/{id}/approve/",
          "description": "Aprobar cotización (solo admin)",
          "permission": "admin",
          "response": "Crea proyecto automáticamente"
        },
        "reject": {
          "url": "POST /api/branding/quotes/{id}/reject/",
          "description": "Rechazar cotización (solo admin)",
          "permission": "admin",
          "request_body": {
            "rejected_reason": "string"
          }
        }
      },
      "projects": {
        "list": {
          "url": "GET /api/branding/projects/",
          "description": "Lista proyectos (filtrados por rol)",
          "filters": {
            "cliente": "client === user_id",
            "diseñador": "assigned_to === user_id",
            "admin": "todos los proyectos"
          }
        },
        "create": {
          "url": "POST /api/branding/projects/",
          "description": "Crear proyecto (clientes crean con status='quote')",
          "request_body": {
            "title": "string",
            "brief": "string",
            "service": "number (service_id)",
            "delivery_date": "date (opcional)"
          }
        },
        "assign_designer": {
          "url": "POST /api/branding/projects/{id}/assign_designer/",
          "description": "Asignar diseñador (solo admin)",
          "permission": "admin",
          "request_body": {
            "designer_id": "number"
          }
        }
      }
    }
  },
  "project_communication": {
    "endpoints": {
      "messages": {
        "list": {
          "url": "GET /api/branding/projects/messages/?project={project_id}",
          "description": "Lista mensajes de un proyecto",
          "filters": "project === project_id"
        },
        "create": {
          "url": "POST /api/branding/projects/messages/",
          "description": "Crear mensaje en proyecto",
          "request_body": {
            "project": "number (project_id)",
            "message": "string",
            "is_internal": "boolean (opcional, default false)"
          }
        }
      }
    }
  },
  "payments": {
    "endpoints": {
      "simulate": {
        "url": "POST /api/branding/payments/simulate/",
        "description": "Simular pago (actualiza proyecto)",
        "request_body": {
          "project_id": "number",
          "amount": "decimal",
          "cardholder_name": "string (opcional)",
          "card_last4": "string (opcional)"
        },
        "response": "Actualiza paid_amount y status del proyecto"
      },
      "list": {
        "url": "GET /api/branding/payments/",
        "description": "Lista pagos (filtrados por proyecto)",
        "filters": "project === project_id"
      }
    }
  },
  "user_management": {
    "endpoints": {
      "list_users": {
        "url": "GET /api/user/admin/users/",
        "description": "Listar todos los usuarios con filtros (solo admin)",
        "permission": "admin",
        "query_params": {
          "role": "string (opcional) - Filtrar por rol",
          "search": "string (opcional) - Buscar por nombre o email"
        },
        "response": {
          "users": "array de usuarios",
          "total": "number",
          "filters": "object con filtros aplicados"
        }
      },
      "list_designers": {
        "url": "GET /api/user/admin/designers/",
        "description": "Listar solo diseñadores para asignación (solo admin)",
        "permission": "admin",
        "response": {
          "designers": "array de diseñadores",
          "total": "number"
        }
      },
      "set_role": {
        "url": "POST /api/user/admin/set-role/",
        "description": "Cambiar rol de usuario (solo admin)",
        "permission": "admin",
        "request_body": {
          "user_id": "number",
          "role": "string (diseñador|cliente|gerente|vendedor|admin)"
        }
      }
    }
  },
  "ecommerce": {
    "endpoints": {
      "products": {
        "list": {
          "url": "GET /api/branding/products/",
